# Runtime
aPP_ENV=development
APP_TIMEZONE=America/Monterrey

# MongoDB Atlas
MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=barber_page

# Authentication
# Use at least 32 random characters for JWT_SECRET in production.
JWT_SECRET=replace-with-at-least-64-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-one-time-password
JWT_TTL_MINUTES=720

# Allowed browser origins, comma-separated.
# Replace these with the final Cloudflare Pages domains in production.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Integration tests only. Do not commit real values.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
