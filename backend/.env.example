# MongoDB Atlas
MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=barber_page

# Authentication
# Generate a long random value. Never commit the real secret.
JWT_SECRET=replace-with-at-least-64-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-one-time-password

# Allowed browser origins, comma-separated.
# Add the final Cloudflare Pages URL after deployment.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Application timezone
APP_TIMEZONE=America/Monterrey

# Optional runtime configuration
JWT_EXPIRATION_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
BOOKING_MAX_ATTEMPTS=10
BOOKING_WINDOW_MINUTES=15
